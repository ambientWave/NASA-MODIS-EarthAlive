# Copy this file to .env and fill in your NASA Earthdata credentials.
# .env is git-ignored and must never be committed.
#
# Option A: username + password
EARTHDATA_USERNAME=your_earthdata_username
EARTHDATA_PASSWORD=your_earthdata_password

# Option B: Earthdata login token (takes precedence over username/password)
# EARTHDATA_TOKEN=

# Optional. One of: environment | netrc | all | interactive
# Default when credentials are present: environment
# Default when they are absent: netrc
# EARTHDATA_AUTH_STRATEGY=environment
